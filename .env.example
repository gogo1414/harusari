# 환경변수 설정 (복사 후 .env.local로 이름 변경)

# Supabase 설정
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 서비스 역할 키 (Cron 작업용, RLS 우회)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# 카카오 로컬 REST API 키 (선택: 국내 장소 검색 정확도 향상, 미설정 시 OpenStreetMap(Photon) 사용)
# https://developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키
KAKAO_REST_API_KEY=

# AI 빠른 입력 (Gemini) - Google AI Studio에서 발급
# 미설정 시 규칙 기반 분석으로 동작
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Cron 라우트 인증 (GitHub Actions secrets의 CRON_SECRET과 동일하게)
CRON_SECRET=

# 지출 지도 타일 (선택). 미설정 시 OpenStreetMap 기본 타일 사용
# 트래픽이 늘면 키가 있는 타일 제공자(예: MapTiler, Stadia) URL로 교체 권장
NEXT_PUBLIC_MAP_TILE_URL_LIGHT=
NEXT_PUBLIC_MAP_TILE_URL_DARK=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
